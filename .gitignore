/[Mm]emoryCaptures/
/[Rr]ecordings/
/Assets/StreamingAssets/build_info.json
/Assets/StreamingAssets/build_info.json.meta

# IDE / generated project files
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
